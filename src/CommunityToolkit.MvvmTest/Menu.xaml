<!--
    自定义控件示例主菜单窗口
    该窗口提供了一系列按钮，用于导航到不同类型的自定义控件演示页面
-->
<Window x:Class="WpfApp.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
