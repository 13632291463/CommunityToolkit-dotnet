        Title="Menu"
        Width="300"
        Height="Auto">
    <!--  主网格容器  -->
    <Grid>
        <!--  垂直堆叠面板，包含所有菜单项  -->
        <StackPanel Margin="5" HorizontalAlignment="Left" Button.Click="ButtonClick">
            <!--  第18.2节示例：基本用户控件  -->
            <Label Content="18.2 构建基本的用户控件" />
            <Button>MainWindow2</Button>

            <Label Content="1. 基础 ObservableObject 和 ObservableProperty" />
            <Button>MainWindow</Button>

            <Label Content="2. RelayCommand 的使用" />
            <Button>CommandWindow</Button>

            <Label Content="3. 数据验证示例" />
            <Button>ValidationWindow</Button>

            <Label Content="4. Messenger 消息传递" />
            <Button>MessengerWindow</Button>

            <Label Content="5. 依赖注入示例" />
            <!--<Button>CustomDrawnElementChrome</Button>-->

            <Label Content="6. 高级用法 - 部分方法" />
            <Button>AdvancedWindow</Button>

            <Label Content="7. 继承和多态示例" />
            <Button></Button>

            <Label Content="8. 通知属性更改依赖项" />
            <Button>DependentPropertyWindow</Button>

            <Label Content="9. 异步命令示例" />
            <Button>AsyncCommandWindow</Button>

            <Label Content="5. 依赖注入示例" />
            <Button>CustomDrawnElementChrome</Button>

        </StackPanel>

    </Grid>
</Window>
