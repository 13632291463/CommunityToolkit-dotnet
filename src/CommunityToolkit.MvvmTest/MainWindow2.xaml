<Window x:Class="WpfApp.MainWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="CommunityToolkit.Mvvm 示例"
        Width="400"
        Height="300">

    <Window.DataContext>
        <vm:MainViewModel2 />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  姓名显示  -->
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="姓名:" />
        <TextBox x:Name="nameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="0"
                Grid.Column="2"
                Margin="5"
                Content="更新"
                Command="{Binding UpdateNameCommand}"
                CommandParameter="{Binding ElementName=nameTextBox, Path=Text}" />

        <!--  年龄显示  -->
        <Label Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center" Content="年龄:" />
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Center" Text="{Binding Age, StringFormat='当前年龄: {0}'}" />

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5" Orientation="Horizontal">
            <Button Margin="0,0,5,0" Content="增加" Command="{Binding IncrementAgeCommand}" />
            <Button Content="减少" Command="{Binding DecrementAgeCommand}" />
        </StackPanel>

        <!--  启用状态  -->
        <CheckBox Grid.Row="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="5"
                  Content="启用功能"
                  IsChecked="{Binding IsEnabled}" />

        <!--  显示信息  -->
        <!--<TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="5,20,5,5" TextWrapping="Wrap"
                   Text="{Binding Name, StringFormat='你好, {0}! 你今年 {Binding Age} 岁了。'}"/>-->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel>
                <TextBlock Margin="5,20,5,5" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="你好, {0}! 你今年 {1} 岁了。">
                            <Binding Path="Name" />
                            <Binding Path="Age" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="5,20,5,5" TextWrapping="Wrap" Text="{Binding GreetingMessage}" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>